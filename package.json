    "check:boundary": "node scripts/check-boundary.mjs",
    "sync:functions": "node scripts/sync-functions.mjs",
    "check": "npm run typecheck && npm run check:boundary && npm run validate:cases && npm test",
    "usage:report": "tsx scripts/usage-report.ts",
    "simulate:budget": "tsx scripts/simulate-budget.ts",
    "art": "node scripts/gen-art.mjs",
    "fonts": "python scripts/subset-fonts.py"
  },
